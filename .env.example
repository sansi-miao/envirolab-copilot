# Local development defaults. Copy values into the deployment environment; never commit real secrets.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Comma-separated explicit origins. Local development origins are always retained.
# Production example: https://app.example.com,http://127.0.0.1:5173,http://localhost:5173
# Wildcard "*" is rejected.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production frontend build example (must be an absolute HTTPS URL ending in /api):
# VITE_API_BASE_URL=https://api.example.com/api

# Crossref contact identity. CROSSREF_USER_AGENT defaults to EnviroLabCopilot/0.1.0.
# CROSSREF_MAILTO=research@example.org
# CROSSREF_USER_AGENT=EnviroLabCopilot/0.1.0

# Shared rate-limit counter. Use sqlite for multiple workers on one host.
# Multi-instance deployments need a shared external counter instead.
LITERATURE_RATE_LIMIT_BACKEND=sqlite
# LITERATURE_RATE_LIMIT_DB=data/literature_rate_limit.sqlite3
# LITERATURE_RATE_LIMIT_PER_IP=10
# LITERATURE_RATE_LIMIT_GLOBAL=30

# Only trust X-Forwarded-For when the immediate peer is one of these proxies.
# TRUSTED_PROXY_IPS=127.0.0.1

# AI and other service credentials belong only in backend secrets; do not add VITE_* keys for them.
